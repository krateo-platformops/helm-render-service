{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "krateo-helm-render-service",
  "description": "Stateless helm-template render/dry-run HTTP service \u2014 full-coverage schema.",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "title": "Replica count",
      "minimum": 0,
      "default": 1
    },
    "image": {
      "type": "object",
      "title": "Image",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "title": "Image registry",
          "description": "Registry host; overridden by global.imageRegistry when set.",
          "default": "ghcr.io"
        },
        "repository": {
          "type": "string",
          "title": "Image repository",
          "default": "krateo-platformops/helm-render-service"
        },
        "pullPolicy": {
          "type": "string",
          "title": "Image pull policy",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ],
          "default": "IfNotPresent"
        },
        "tag": {
          "type": "string",
          "title": "Image tag",
          "description": "Overrides the image tag whose default is the chart appVersion.",
          "default": ""
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "title": "Image pull secrets",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "nameOverride": {
      "type": "string",
      "title": "Name override",
      "default": ""
    },
    "fullnameOverride": {
      "type": "string",
      "title": "Fullname override",
      "default": ""
    },
    "service": {
      "type": "object",
      "title": "Service",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "title": "Service type",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ],
          "default": "ClusterIP"
        },
        "port": {
          "type": "integer",
          "title": "Service port",
          "default": 8080
        }
      }
    },
    "resources": {
      "type": "object",
      "title": "Resources",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "title": "Requests",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "title": "CPU request",
              "x-kubernetes-int-or-string": true
            },
            "memory": {
              "type": "string",
              "title": "Memory request",
              "default": "128Mi"
            }
          }
        },
        "limits": {
          "type": "object",
          "title": "Limits",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "title": "CPU limit",
              "x-kubernetes-int-or-string": true
            },
            "memory": {
              "type": "string",
              "title": "Memory limit",
              "default": "512Mi"
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "title": "Service configuration (HRS_* env)",
      "description": "Empty string leaves the env var unset; the binary's built-in default applies.",
      "additionalProperties": false,
      "properties": {
        "kubeVersion": {
          "type": "string",
          "title": "HRS_KUBE_VERSION",
          "description": ".Capabilities.KubeVersion presented to templates (binary default v1.33.0).",
          "default": ""
        },
        "renderTimeout": {
          "type": "string",
          "title": "HRS_RENDER_TIMEOUT",
          "description": "Per-request render timeout as a Go duration, e.g. 15s (binary default 15s).",
          "default": ""
        },
        "maxRequestBytes": {
          "title": "HRS_MAX_REQUEST_BYTES",
          "description": "Request body cap in bytes (binary default 2097152 = 2 MiB).",
          "x-kubernetes-int-or-string": true
        },
        "maxChartBytes": {
          "title": "HRS_MAX_CHART_BYTES",
          "description": "Chart download cap in bytes (binary default 20971520 = 20 MiB).",
          "x-kubernetes-int-or-string": true
        },
        "maxOutputBytes": {
          "title": "HRS_MAX_OUTPUT_BYTES",
          "description": "Rendered output cap in bytes (binary default 5242880 = 5 MiB).",
          "x-kubernetes-int-or-string": true
        },
        "allowHTTP": {
          "type": "boolean",
          "title": "HRS_ALLOW_HTTP",
          "description": "Allow plain http:// chart URLs (trusted dev environments only).",
          "default": false
        }
      }
    },
    "snowplowEndpoint": {
      "type": "object",
      "title": "snowplow Endpoint Secret",
      "description": "Optional Secret in the release namespace whose server-url points at this chart's Service, for snowplow RESTAction endpointRef.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Create the Endpoint Secret",
          "default": true
        },
        "name": {
          "type": "string",
          "title": "Secret name",
          "default": "helm-render-endpoint"
        }
      }
    },
    "global": {
      "type": "object",
      "title": "Global values",
      "description": "Helm global values (injected when used as a subchart).",
      "properties": {
        "imageRegistry": {
          "type": "string",
          "title": "Global image registry",
          "description": "Overrides the registry host of all images (repository paths preserved) for mirror/air-gapped installs.",
          "default": ""
        }
      }
    }
  }
}
