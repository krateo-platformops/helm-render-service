      {
        "path": "Chart.yaml",
        "content": "apiVersion: v2\nname: demo\nversion: 0.1.0\n"
      },
      {
        "path": "values.yaml",
        "content": "greeting: hello\n"
      },
      {
        "path": "values.schema.json",
